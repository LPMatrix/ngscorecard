{
  "name": "ngscorecard",
  "version": "1.0.0",
  "description": "Independent, open tracker of Nigerian government promises versus delivery.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env server/dev.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.js --outDir dist/server",
    "preview": "vite preview",
    "test": "node --test --experimental-test-module-mocks \"test/*.test.mjs\"",
    "start": "node server/index.js",
    "db:push": "drizzle-kit push",
    "db:seed": "node --env-file=.env server/seed.js",
    "db:seed:reset": "node --env-file=.env server/seed.js --reset",
    "db:studio": "drizzle-kit studio",
    "db:backup": "node --env-file=.env scripts/backup-db.mjs",
    "export:dataset": "node --env-file=.env scripts/export-dataset.mjs",
    "sitemap": "node --env-file=.env scripts/generate-sitemap.mjs",
    "paystack:setup-plan": "node --env-file=.env scripts/setup-paystack-plan.mjs",
    "rag:sync-portal": "node --env-file=.env scripts/sync-portal.mjs",
    "lgas:import": "node scripts/import-lgas.mjs",
    "rag:remove": "node --env-file=.env scripts/remove-rag-documents.mjs",
    "rag:rechunk": "node --env-file=.env scripts/rechunk-rag.mjs",
    "eval:rag": "node --env-file-if-exists=.env scripts/eval-rag.mjs",
    "eval:rag:corpus": "node scripts/update-eval-corpus.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "openai": "^4.72.0",
    "satori": "^0.33.4",
    "sharp": "^0.34.5",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
