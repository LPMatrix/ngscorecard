# Copy to .env and fill in. See README.md → "Running locally".

# Database — hosted libSQL/SQLite (https://turso.tech).
# Leave both blank to fall back to a local SQLite file at data/ngscorecard.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The /admin editor.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: opt in to the public one-request dataset export (GET /api/v1/dump).
# DATASET_DUMP_PUBLIC=true

# Donate feature (Support page) — https://dashboard.paystack.com/#/settings/developer
# Test keys work end-to-end with Paystack's published test card numbers.
# One-time donations need just the two keys. For "Monthly", run
# `npm run paystack:setup-plan` once and add the plan code it prints.
# Webhook URL to set in the Paystack dashboard: https://<your-domain>/api/donate/webhook
# On Vercel, add the same variables to the project's environment settings too.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# PAYSTACK_MONTHLY_PLAN_CODE=
