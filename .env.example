# Copy to .env and fill in. See README.md → "Running locally".

# Database — hosted libSQL/SQLite (https://turso.tech).
# Leave both blank to fall back to a local SQLite file at data/ngscorecard.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The /admin editor.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: opt in to the public one-request dataset export (GET /api/v1/dump).
# DATASET_DUMP_PUBLIC=true
