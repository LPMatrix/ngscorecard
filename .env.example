# Copy to .env and fill in. See README.md → "Running locally".

# Database — hosted libSQL/SQLite (https://turso.tech).
# Leave both blank to fall back to a local SQLite file at data/ngscorecard.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The /admin editor.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: opt in to the public one-request dataset export (GET /api/v1/dump).
# DATASET_DUMP_PUBLIC=true

# Donate feature (Support page) — https://dashboard.paystack.com/#/settings/developer
# Test keys work end-to-end with Paystack's published test card numbers.
# One-time donations need just the two keys. For "Monthly", run
# `npm run paystack:setup-plan` once and add the plan code it prints.
# Webhook URL to set in the Paystack dashboard: https://<your-domain>/api/donate/webhook
# On Vercel, add the same variables to the project's environment settings too.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# PAYSTACK_MONTHLY_PLAN_CODE=

# Q&A assistant (/services, "Ask"). Get a key at https://openrouter.ai/keys; OpenRouter
# keys start with "sk-or-". Without one the page returns the retrieved sources only.
OPENROUTER_API_KEY=
# Optional: override the model (default anthropic/claude-sonnet-5.5). Ids: https://openrouter.ai/models
# RAG_MODEL=
# Optional: the cheaper model that turns a follow-up ("And for minors?") into a standalone
# search question (default anthropic/claude-haiku-5.5). Answers still use RAG_MODEL.
# RAG_REWRITE_MODEL=
# Optional: model for the promise tools (outcome verifier, promise classifier), default
# anthropic/claude-sonnet-5.5. They use OPENROUTER_API_KEY too; there is no separate provider key.
# AI_TOOLS_MODEL=

# Newsletter signup (the form in the footer and on publications pages). Readers confirm by
# email (double opt-in). Sending needs Resend (https://resend.com): create an API key and
# verify the domain you send from. Without RESEND_API_KEY, development prints the confirmation
# email to the terminal and production reports signup as unavailable.
RESEND_API_KEY=
# Sender shown on the email; its domain must be verified in Resend.
# NEWSLETTER_FROM=NGScorecard <newsletter@ngscorecard.com>
# Base URL for the links in those emails (default https://ngscorecard.com in production; the
# request's own address in development). Set it on preview deployments.
# SITE_URL=https://ngscorecard.com
